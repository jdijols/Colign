# --- Node / Yarn / pnpm ---
node_modules/
.yarn/
.pnp.*
.pnpm-store/

# --- Vite / build outputs ---
dist/
build/
.vite/

# --- Java / Maven / Gradle ---
target/
.gradle/
*.class
*.jar
*.war
*.ear
hs_err_pid*.log
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- IDE / editor ---
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store

# --- Env / secrets ---
.env
.env.*
!.env.example
application-local.yml
application-local.properties

# --- Test artifacts ---
.nyc_output/
coverage/
cypress/videos/
cypress/screenshots/
cypress/downloads/
.cypress-cache/
cypress-results/
jacoco.exec
jacoco-it.exec

# --- Logs ---
tmp/
*.log
*.log.*

# --- Generated: Tailwind precompiled output for MF CSS crossing ---
# (produced by `yarn build:css` / `yarn dev:css`; regenerated, never edited)
apps/*/src/*-compiled.css

# --- Generated: TypeScript incremental build info ---
*.tsbuildinfo

# --- Generated: Module Federation type hints + diagnostics ---
**/@mf-types/
**/.mf/

# --- Misc ---
.gstack/
.superpowers/
.audit-snapshot/
apps/colign-frontend/cypress/screenshots/

# --- Design loop harness state (runtime only) ---
tools/design-loop/state/*
!tools/design-loop/state/.gitkeep
.design-loop-pids
