{
  "name": "pa-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PA host shell — minimal Vite app that consumes the WC Module Federation remote on /weekly-commit/*. Demonstrates the remote can be embedded without modification.",
  "scripts": {
    "dev": "vite --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@reduxjs/toolkit": "^2.2.7",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.5.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
