{
  "name": "colign-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ST6 Weekly Commit Module — Vite 5 + React 18 Module Federation REMOTE. Runs standalone on :5174 or is consumed by apps/pa-host.",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:css": "tailwindcss -i src/index.css -o src/colign-compiled.css --watch",
    "build:css": "tailwindcss -i src/index.css -o src/colign-compiled.css --minify",
    "prebuild": "yarn build:css",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "cy:open": "cypress open --e2e --browser chrome",
    "cy:run": "cypress run --browser chrome --e2e",
    "cy:ci": "start-server-and-test 'vite preview --port 5174' http://localhost:5174 'cypress run --browser chrome --e2e'"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@reduxjs/toolkit": "^2.2.7",
    "flowbite": "^2.5.2",
    "flowbite-react": "^0.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^21.0.3",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.3",
    "@module-federation/vite": "^1.5.0",
    "@tailwindcss/forms": "^0.5.9",
    "@testing-library/cypress": "^10.0.3",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.15.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "cypress-multi-reporters": "^2.0.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.2.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "start-server-and-test": "^2.0.10",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
