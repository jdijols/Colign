# Copy to .env.local for your machine.

# Backend API base URL. Vite dev proxies /api → this.
VITE_API_BASE=http://localhost:8080

# Auth mode:
#   mock  → /__dev__/mint endpoint mints RS256 demo JWTs (see vite.config.ts)
#   real  → use @auth0/auth0-react redirect flow against the tenant below
VITE_AUTH_MODE=mock

# Auth0 (only used when VITE_AUTH_MODE=real)
VITE_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://api.wc.local
